# tuned/repo.env -- flashinfer-specific settings for tuned builds. Sourced by tuned/env.sh after the shared
# device and toolkit definitions (tuned/common-data, vendored from zbrad/tuned-common). Tracked, so a release is
# reproducible.
#
# This file only ADDS repo-specific settings. Changing a shared key (GPU_TUNED_VARIANT/PLATFORM/CUDA_ARCH/HW_LABEL,
# CUDA_*, TOOLKIT_*) is a loud error from gpu_tuned_load_repo_env. Plain assignment on purpose: this file is sourced
# inside a function, where `declare` would make the variable local and lose it.

# Upstream ref the DRAFT notes compare against (the merge-base of HEAD with it).
GPU_TUNED_UPSTREAM_REF="${GPU_TUNED_UPSTREAM_REF:-upstream/main}"

# flashinfer's FLASHINFER_CUDA_ARCH_LIST spelling is dotted ("12.1a", "8.9"); the shared device files carry the
# resolved cuobjdump form ("121a", "89"). Insert the dot before the last digit.
GPU_TUNED_FLASHINFER_ARCH="$(printf '%s' "${GPU_TUNED_CUDA_ARCH}" | sed -E 's/^([0-9]+)([0-9])(a?)$/\1.\2\3/')"

# The torch wheel the build venv holds (flashinfer's build imports torch; nothing is installed outside the venv).
# A fork wheel: no aarch64/sm_121 torch exists upstream.
GPU_TUNED_TORCH_WHEEL_URL=""

case "${GPU_TUNED_VARIANT}" in
    gb10)
        GPU_TUNED_TORCH_WHEEL_URL="https://github.com/zbrad/pytorch/releases/download/v2.15.0%2Bgb10.cu134.20261012/torch-2.15.0%2Bgb10.cu134.20261012-cp314-cp314-linux_aarch64.whl"
        # The pinned torch wheel and its consumers (vllm) exist for cu134 only.
        GPU_TUNED_REPO_TOOLKITS="cu134"
        GPU_TUNED_REPO_TOOLKIT_REASON="The pinned torch wheel (GPU_TUNED_TORCH_WHEEL_URL in tuned/repo.env) exists for cu134 only; build with CUDA_TAG=cu134."
        # GB10 additionally ships a target-model-scoped flashinfer-jit-cache wheel
        # for a genuine zero-runtime-JIT deployment (see tuned/build.sh). Scoped to
        # nvidia/NVIDIA-Nemotron-3-Super-120B-A12B-NVFP4 (NemotronH hybrid
        # Mamba+Attention, head_dim=128 GQA, bf16, NVFP4 MoE) AND
        # deepseek-ai/DeepSeek-V4-Flash (MLA attention, head_dim=512,
        # qk_rope_head_dim=64, bf16, fp8 MoE) -- confirmed working end-to-end via
        # the Nemotron-3-Nano-30B-A3B-NVFP4 stand-in (same mamba_head_dim=64), see
        # vllm's tuned/gb10_acceptance_test.sh. FA3 (192,128) is kept alongside
        # (128,128) as a safety margin for any legacy-shaped MLA fallback in
        # DeepSeek-V4's generic FA3 path -- unchanged from the original
        # scripts/build_gb10.sh this was consolidated from; do not drop it here
        # without re-verifying against the real DeepSeek-V4-Flash checkpoint (see
        # tuned/devices/rtx50.conf for why its own, newer AOT scope omits this same
        # margin -- DeepSeek-V4 isn't reachable on rtx50/SM120 at all today, for a
        # reason unrelated to this specific flag, so there was nothing to carry
        # forward there).
        GPU_TUNED_NEEDS_AOT_JIT_CACHE="true"
        GPU_TUNED_AOT_FA2_HEAD_DIM="128,128"
        GPU_TUNED_AOT_FA3_HEAD_DIM="128,128 192,128"
        GPU_TUNED_AOT_F16_DTYPE="bfloat16"
        GPU_TUNED_AOT_ADD_COMM="false"    # single GPU box, no NCCL-style collectives
        GPU_TUNED_AOT_ADD_GEMMA="false"   # target model isn't Gemma
        GPU_TUNED_AOT_ADD_OAI_OSS="false" # target model isn't gpt-oss
        GPU_TUNED_AOT_ADD_MOE="true"      # NemotronH target is NVFP4 MoE
        GPU_TUNED_AOT_ADD_ACT="true"
        GPU_TUNED_AOT_ADD_MISC="true"     # norm/rope/sampling/page + Mamba SSU (needed for Nemotron-3-Super)
        GPU_TUNED_AOT_ADD_XQA="true"      # vllm 0.32 takes the FlashInfer attention backend (XQA decode) for the NVFP4 NemotronH models
        # XQA shapes to precompile (comma-separated; flashinfer/aot.py reads FLASHINFER_AOT_XQA_*). Not upstream's full grid: the shapes
        # vllm 0.32 requested on this GPU for NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4 (bf16, fp8 e4m3 KV, page 16, head_dim 128,
        # head_group_ratio 16), widened to the other page sizes vllm can pick and group ratio 8. Anything else compiles at runtime
        # unless FLASHINFER_DISABLE_JIT=1, in which case it fails loudly.
        GPU_TUNED_AOT_XQA_INPUT_TYPE="bfloat16"
        GPU_TUNED_AOT_XQA_FP8_KV_CACHE="true,false"
        GPU_TUNED_AOT_XQA_TOKEN_PER_PAGE="16,32,64"
        GPU_TUNED_AOT_XQA_HEAD_SIZE="128"
        GPU_TUNED_AOT_XQA_HEAD_GRP_SIZE="8,16"
        ;;
    rtx40)
        # Not built from this repo yet: untested. No torch wheel is pinned.
        GPU_TUNED_REPO_TOOLKITS=""
        GPU_TUNED_REPO_TOOLKIT_REASON=""
        # No AOT-scoped jit-cache build for this variant: no target model scoping decided (see rtx50). Kernels
        # JIT-compile lazily on first call, so only the flashinfer-python wheel would ship.
        GPU_TUNED_NEEDS_AOT_JIT_CACHE="false"
        ;;
    rtx50)
        # Not built from this repo yet: untested. No torch wheel is pinned.
        GPU_TUNED_REPO_TOOLKITS=""
        GPU_TUNED_REPO_TOOLKIT_REASON=""
        GPU_TUNED_NEEDS_AOT_JIT_CACHE block below for why this matters now that
        # this variant does ship an AOT/no-JIT build (it didn't when this note was
        # first written).

        GPU_TUNED_VARIANT="rtx50"
        GPU_TUNED_COMPUTE_CAP="12.0"
        GPU_TUNED_CUDA_ARCH="12.0a"
        GPU_TUNED_HW_LABEL="RTX 50-series (Blackwell consumer, desktop/laptop, SM 120a)"

        # rtx50 ships a target-model-scoped flashinfer-jit-cache wheel, matching
        # gb10 (see tuned/devices/gb10.conf). Two target models:
        #   - nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B-NVFP4 (NemotronH hybrid
        #     Mamba+Attention, mamba_head_dim=64, head_dim=128 GQA, bf16, NVFP4 MoE,
        #     ~19GB) -- same architecture family as gb10's Nemotron-3-Super-120B
        #     target, sized to actually fit a 32GB card. Confirmed via vllm's
        #     tuned/gb10_acceptance_test.sh to work under strict no-JIT on the gb10
        #     stack; not yet independently verified on rtx50 hardware specifically.
        #   - Qwen 2.5 32B (dense, standard GQA, head_dim=128, bf16, no MoE) --
        #     confirmed via live config.json fetch: same head_dim=128 attention
        #     shape as the NemotronH target above, so it's covered by the same
        #     FA2/FA3 head_dim=128 + ADD_MISC (norm/rope/sampling) scope with no
        #     additional AOT flags needed. Dense, so it never touches the MoE ops
        #     this scope also compiles for the NemotronH target -- harmless overlap,
        #     not a conflict.
        #
        # Unlike gb10, this build does NOT drop the DeepSeek-V4 FA3 192,128 safety
        # margin -- there was never a working DeepSeek-V4 stand-in on this SM
        # family to carry it forward for in the first place. DeepSeek-V4 does not
        # run on SM120 (this chip) OR SM121 (gb10) today regardless of model size:
        # vLLM's vendored DeepGEMM has no SF-layout transform for arch_major=12 at
        # the granularity DeepSeek-V4's NVFP4 expert scales use -- a hard
        # compile/runtime assertion, unrelated to flashinfer or VRAM.
        #
        # ⚠ Known open risk, not yet resolved: flashinfer's fp4_quantization.py
        # unconditionally redirects backend "120"/"121" to "120f" whenever the
        # CONSUMING process's installed torch was built against CUDA >= 12.9
        # (torch.version.cuda, checked at runtime -- independent of what arch this
        # AOT cache was actually built for). This build's AOT cache does NOT
        # include the sm120f module (FLASHINFER_CUDA_ARCH_LIST is "12.0a" only, and
        # has_sm120f in flashinfer/aot.py's gen_all_modules() is purely
        # arch-list-driven). If vllm's own installed torch is CUDA>=12.9, any code
        # path that calls get_fp4_quantization_module() (confirmed real call site:
        # flashinfer/activation.py -- exercised by NVFP4 MoE routing, plausible but
        # not confirmed for this exact target model) will raise
        # MissingJITCacheError under strict no-JIT. Deliberately choosing to keep
        # FLASHINFER_DISABLE_JIT=1 enforced anyway (see vllm's tuned/run_rtx50.sh)
        # so this surfaces as a loud, immediate fault instead of silently degrading
        # -- vllm's tuned/verify_fp4_arch_match.py exercises this exact call path
        # at startup specifically so the fault (if any) is unambiguous and early,
        # not buried in a real generation call. Not yet empirically confirmed
        # either way on real hardware -- no torch/flashinfer install in this
        # environment to test against yet.
        GPU_TUNED_NEEDS_AOT_JIT_CACHE="true"
        GPU_TUNED_AOT_FA2_HEAD_DIM="128,128"
        GPU_TUNED_AOT_FA3_HEAD_DIM="128,128"
        GPU_TUNED_AOT_F16_DTYPE="bfloat16"
        GPU_TUNED_AOT_ADD_COMM="false"    # single GPU box, no NCCL-style collectives
        GPU_TUNED_AOT_ADD_GEMMA="false"   # neither target model is Gemma
        GPU_TUNED_AOT_ADD_OAI_OSS="false" # neither target model is gpt-oss
        GPU_TUNED_AOT_ADD_MOE="true"      # NemotronH target is NVFP4 MoE (Qwen doesn't need it, harmless)
        GPU_TUNED_AOT_ADD_ACT="true"
        GPU_TUNED_AOT_ADD_MISC="true"     # norm/rope/sampling/page + Mamba SSU (needed for NemotronH)
        GPU_TUNED_AOT_ADD_XQA="false"     # not used by either target model on this backend
        ;;
    *)
        echo "ERROR: tuned/repo.env has no settings for variant '${GPU_TUNED_VARIANT}' (gb10, rtx40, rtx50)." >&2
        return 1
        ;;
esac

# Strings the fork keeps in upstream-owned files; tools/upstream-sync.sh (GPU_TUNED_FORK_MARKERS in its environment,
# comma-separated) refuses a merge that loses one. The second marks the XQA/trtllm_utils AOT additions in flashinfer/aot.py.
GPU_TUNED_FORK_MARKERS="gpu_tuned_,FLASHINFER_AOT_XQA_INPUT_TYPE"
